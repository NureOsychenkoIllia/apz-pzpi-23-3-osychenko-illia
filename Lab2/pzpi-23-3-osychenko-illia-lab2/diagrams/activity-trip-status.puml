@startuml
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"

start
:Користувач відкриває список рейсів;
:TripsViewModel запитує рейси через TripRepository;
:Repository викликає GET /trips;
if (Сервер повернув список?) then (так)
  :Екран відображає рейси і фільтри;
  :Користувач відкриває деталі рейсу;
  :TripDetailViewModel викликає GET /trips/{id};
  :Екран показує маршрут, автобус,\nпоточну завантаженість і статус;
  if (Потрібно змінити статус?) then (так)
    :Користувач обирає новий статус;
    :TripDetailViewModel викликає PUT /trips/{id};
    if (Оновлення успішне?) then (так)
      :Стан екрана оновлюється через StateFlow;
      :Користувач бачить повідомлення\n"Статус оновлено";
    else (ні)
      :Показується повідомлення про помилку;
    endif
  else (ні)
    :Користувач переглядає деталі без зміни даних;
  endif
else (ні)
  :Показується повідомлення\nпро помилку з'єднання або API;
endif
stop
@enduml
